                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"juliosshoji\",\n  \"passwordHash\": \"8d969eef6ecad3c29a3a873fba8fe814ea412bfce19db27c81052fe959408b8515\"\n}\n\nNote: passwordHash is SHA256 of 'password123'\nGenerate using: sha256(password).hexdigest() in Python\nor crypto.createHash('sha256').update(password).digest('hex') in Node.js"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
